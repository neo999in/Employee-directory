# MySQL connection (replace placeholders; never commit real credentials)
DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/employee_directory?charset=utf8mb4

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Optional tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=3600
SEED_ON_STARTUP=true
