# Local / Native Setup (one .env per app):
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env
#
# Docker Setup (root directory):
#   .env.docker.example   -> .env (optional, docker-compose has built-in defaults)
#
# --- Backend (.env) ---
DATABASE_URL=mysql+pymysql://<user>:<password>@localhost:3306/employee_directory?charset=utf8mb4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (.env) ---
VITE_API_BASE_URL=http://localhost:8000/api
