# ==========================================
# Backend Configuration (.env in backend/)
# ==========================================
# Database Connection URL:
# For SQLite (default, self-contained):
DATABASE_URL=sqlite:///./employees.db
# For MySQL (production alternative):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/employee_directory

# CORS Origins (comma-separated):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Frontend Configuration (.env in frontend/)
# ==========================================
# Base API URL used by the React client:
VITE_API_BASE_URL=http://localhost:8000/api
